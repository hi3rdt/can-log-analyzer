{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "STM32: debug (OpenOCD + ST-Link)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build-fw/firmware.elf",
      "configFiles": [
        "tools/openocd/bluepill.cfg"
      ],
      "device": "STM32F103C8",
      "runToEntryPoint": "main",
      "preLaunchTask": "fw: build",
      "showDevDebugOutput": "none",
      "svdFile": "${workspaceFolder}/tools/svd/STM32F103xx.svd"
    },
    {
      "name": "STM32: attach (no reset, no reflash)",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build-fw/firmware.elf",
      "configFiles": [
        "tools/openocd/bluepill.cfg"
      ],
      "device": "STM32F103C8",
      "svdFile": "${workspaceFolder}/tools/svd/STM32F103xx.svd"
    }
  ]
}
